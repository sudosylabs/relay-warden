# nginx example: shared edge, relay on loopback. Adapt names/ports.
# Put the map in nginx's http context. Obtain a certificate first and set
# the real certificate paths below. This snippet does not provision TLS.

map $http_upgrade $connection_upgrade {
	default upgrade;
	''      close;
}

server {
	listen 443 ssl;
	server_name relay.example.com;
	ssl_certificate /etc/letsencrypt/live/relay.example.com/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/relay.example.com/privkey.pem;

	location ~ ^/(relay|ping)$ {
		proxy_pass http://127.0.0.1:8080;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		# Preserve the relay subprotocol negotiation and client-auth header.
		proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
		proxy_set_header X-Iroh-Relay-Client-Auth-V1 $http_x_iroh_relay_client_auth_v1;
		proxy_read_timeout 1d;
		proxy_send_timeout 1d;
		proxy_buffering off;
	}
}
