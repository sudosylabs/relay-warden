# Caddy example: shared edge, relay on loopback. Adapt names/ports.
# DNS must point here and TCP 80/443 must reach Caddy for automatic HTTPS.
# The relay transport and latency probe are public; administration is not.

relay.example.com {
	@iroh path /relay /ping
	reverse_proxy @iroh 127.0.0.1:8080
	# Do not buffer relay WebSockets; preserve upgrade + subprotocol headers
	# (Caddy passes Sec-WebSocket-Protocol through by default).
}
